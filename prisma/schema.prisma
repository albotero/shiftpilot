generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SomaShiftStatus {
  LIBRE
  R4
  R3
  R2
  R1
  R5
  TURNO
  NOCHE
  TURNO_OTRA_PERSONA
  TURNO_DE_OTRA_PERSONA
  EXTERNO
  EXTERNO_NOCHE
}

enum ShiftPeriod {
  AM
  PM
  NOCHE
}

enum EventCategory {
  SEDARTE
  PERSONAL
}

enum InvoiceType {
  SOMA_POS
  SOMA_PREPAGADA
  SOMA_PARTICULAR
  SEDARTE
}

enum InvoiceStatus {
  PENDIENTE
  FACTURADA
  POR_COBRAR
  PAGADA
  VENCIDA
}

model Work {
  id       String    @id @default(cuid())
  name     String    @unique
  shifts   Shift[]
  events   Event[]
  invoices Invoice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shift {
  id             String           @id @default(cuid())
  workId         String
  work           Work             @relation(fields: [workId], references: [id], onDelete: Restrict)
  date           DateTime         @db.Date
  period         ShiftPeriod
  status         SomaShiftStatus
  durationHours  Int              @default(6)
  manualOverride Boolean          @default(false)
  anesthesiologist String?
  notes          String?
  coverages      ShiftCoverage[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([workId, date, period])
  @@index([date])
}

model ShiftCoverage {
  id         String             @id @default(cuid())
  shiftId    String
  shift      Shift              @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  personId   String
  person     ReplacementPerson  @relation(fields: [personId], references: [id], onDelete: Restrict)
  createdAt  DateTime           @default(now())

  @@unique([shiftId, personId])
  @@index([personId])
}

model ReplacementPerson {
  id         String           @id @default(cuid())
  name       String
  phone      String?
  email      String?
  notes      String?
  active     Boolean          @default(true)
  coverages  ShiftCoverage[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model Vacation {
  id             String   @id @default(cuid())
  startDate      DateTime @db.Date
  endDate        DateTime? @db.Date
  notes          String?
  annualPlanYear Int?     @unique
  createdAt      DateTime @default(now())

  @@index([startDate, endDate])
}

model Event {
  id             String         @id @default(cuid())
  workId         String?
  work           Work?          @relation(fields: [workId], references: [id], onDelete: SetNull)
  category       EventCategory
  title          String
  date           DateTime       @db.Date
  startTime      String?
  durationMinutes Int?
  location       String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([date, category])
}

model Invoice {
  id                    String       @id @default(cuid())
  workId                String
  work                  Work         @relation(fields: [workId], references: [id], onDelete: Restrict)
  type                  InvoiceType
  serviceDate           DateTime     @db.Date
  invoiceDate           DateTime?    @db.Date
  invoiceNumber         String?      @db.VarChar(64)
  expectedPaymentDate   DateTime?    @db.Date
  pdfTotalAmount        Decimal?     @db.Decimal(18, 3)
  grossAmount           Decimal      @db.Decimal(18, 3)
  discountAmount        Decimal      @default(0) @db.Decimal(18, 3)
  shiftDiscountAmount   Decimal      @default(0) @db.Decimal(18, 3)
  netAmount             Decimal      @db.Decimal(18, 3)
  privateShiftCount     Int          @default(0)
  privateShiftAmount    Decimal      @default(0) @db.Decimal(18, 3)
  status                InvoiceStatus @default(PENDIENTE)
  paidAt                DateTime?    @db.Date
  notes                 String?
  items                 InvoiceItem[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([serviceDate, status])
  @@index([expectedPaymentDate])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitAmount  Decimal  @db.Decimal(18, 3)
  discountAmount Decimal @default(0) @db.Decimal(18, 3)
  grossAmount Decimal  @db.Decimal(18, 3)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model SocialSecurityPeriod {
  id             String   @id @default(cuid())
  month          DateTime @unique @db.Date
  grossAmount    Decimal  @default(0) @db.Decimal(18, 3)
  discounts      Decimal  @default(0) @db.Decimal(18, 3)
  netAmount      Decimal  @default(0) @db.Decimal(18, 3)
  ibcAmount      Decimal  @default(0) @db.Decimal(18, 3)
  healthAmountTenths  Int @default(0)
  pensionAmountTenths Int @default(0)
  arlAmountTenths     Int @default(0)
  fundAmountTenths    Int @default(0)
  totalAmountTenths   Int @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Debt {
  id                    String        @id @default(cuid())
  name                  String        @unique @default("Compra de acciones")
  shareCount            Int
  sharePriceCop         Int
  originalAmount        Decimal       @db.Decimal(18, 3)
  contractualRatePpm    Int           @default(80000)
  lateFeeRatePpm        Int           @default(0)
  termMonths            Int
  startDate             DateTime      @db.Date
  schedule              DebtSchedule[]
  payments              DebtPayment[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model DebtSchedule {
  id               String                   @id @default(cuid())
  debtId           String
  debt             Debt                     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  installment      Int
  dueDate          DateTime                 @db.Date
  previousBalance  Decimal                  @db.Decimal(18, 3)
  monthlyInterest  Decimal                  @db.Decimal(18, 3)
  paymentAmount    Decimal                  @db.Decimal(18, 3)
  principalAmount  Decimal                  @db.Decimal(18, 3)
  interestAmount   Decimal                  @db.Decimal(18, 3)
  remainingBalance Decimal                  @db.Decimal(18, 3)
  allocations      DebtPaymentAllocation[]
  createdAt        DateTime                 @default(now())

  @@unique([debtId, installment])
  @@index([dueDate])
}

model DebtPayment {
  id             String                   @id @default(cuid())
  debtId         String
  debt           Debt                     @relation(fields: [debtId], references: [id], onDelete: Restrict)
  paidAt         DateTime                 @db.Date
  amount         Decimal                  @db.Decimal(18, 3)
  parkingAmount  Decimal                  @default(0) @db.Decimal(18, 3)
  notes          String?
  allocations    DebtPaymentAllocation[]
  createdAt      DateTime                 @default(now())

  @@index([paidAt])
}

model DebtPaymentAllocation {
  id                 String       @id @default(cuid())
  paymentId          String
  payment            DebtPayment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  scheduleId         String
  schedule           DebtSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  principalAmount    Decimal      @default(0) @db.Decimal(18, 3)
  interestAmount     Decimal      @default(0) @db.Decimal(18, 3)

  @@unique([paymentId, scheduleId])
}

model ParkingRate {
  id        String   @id @default(cuid())
  year      Int      @unique
  amount    Decimal  @default(0) @db.Decimal(18, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}