generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SomaShiftStatus {
  LIBRE
  R4
  R3
  R2
  R1
  R5
  TURNO
  NOCHE
  TURNO_OTRA_PERSONA
  TURNO_DE_OTRA_PERSONA
  EXTERNO
  EXTERNO_NOCHE
}

enum ShiftPeriod {
  AM
  PM
  NOCHE
}

enum RecurrencePeriod {
  AM
  PM
  AM_PM
  NOCHE
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  INTERVAL
}

enum EventCategory {
  SEDARTE
  PERSONAL
}

enum RecurringEntryKind {
  SOMA
  PERSONAL
}

enum CalendarReminderMode {
  MINUTES_BEFORE
  DAY_AT_5_AM
}

enum InvoiceType {
  SOMA_POS
  SOMA_PREPAGADA
  SOMA_PARTICULAR
  SEDARTE
}

enum InvoiceStatus {
  PENDIENTE
  FACTURADA
  POR_COBRAR
  PAGADA
  VENCIDA
}

model Work {
  id       String    @id @default(cuid())
  name     String    @unique
  shifts   Shift[]
  events   Event[]
  recurrences CalendarRecurrence[]
  invoices Invoice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shift {
  id             String           @id @default(cuid())
  workId         String
  work           Work             @relation(fields: [workId], references: [id], onDelete: Restrict)
  date           DateTime         @db.Date
  period         ShiftPeriod
  status         SomaShiftStatus
  durationHours  Int              @default(6)
  manualOverride Boolean          @default(false)
  anesthesiologist String?
  notes          String?
  reminderEnabled Boolean         @default(false)
  reminderMode   CalendarReminderMode @default(MINUTES_BEFORE)
  reminderMinutesBefore Int       @default(60)
  coverages      ShiftCoverage[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([workId, date, period])
  @@index([date])
}

model ShiftCoverage {
  id         String             @id @default(cuid())
  shiftId    String
  shift      Shift              @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  personId   String
  person     ReplacementPerson  @relation(fields: [personId], references: [id], onDelete: Restrict)
  createdAt  DateTime           @default(now())

  @@unique([shiftId, personId])
  @@index([personId])
}

model ReplacementPerson {
  id         String           @id @default(cuid())
  name       String
  phone      String?
  email      String?
  notes      String?
  active     Boolean          @default(true)
  coverages  ShiftCoverage[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model Vacation {
  id             String   @id @default(cuid())
  startDate      DateTime @db.Date
  endDate        DateTime? @db.Date
  notes          String?
  annualPlanYear Int?     @unique
  reminderEnabled Boolean @default(false)
  reminderMode   CalendarReminderMode @default(MINUTES_BEFORE)
  reminderMinutesBefore Int @default(60)
  createdAt      DateTime @default(now())

  @@index([startDate, endDate])
}

model Event {
  id             String         @id @default(cuid())
  workId         String?
  work           Work?          @relation(fields: [workId], references: [id], onDelete: SetNull)
  category       EventCategory
  title          String
  date           DateTime       @db.Date
  startTime      String?
  durationMinutes Int?
  location       String?
  notes          String?
  reminderEnabled Boolean        @default(false)
  reminderMode   CalendarReminderMode @default(MINUTES_BEFORE)
  reminderMinutesBefore Int      @default(60)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([date, category])
}

model CalendarRecurrence {
  id              String              @id @default(cuid())
  workId          String?
  work            Work?               @relation(fields: [workId], references: [id], onDelete: SetNull)
  kind            RecurringEntryKind
  frequency       RecurrenceFrequency @default(WEEKLY)
  startDate       DateTime            @db.Date
  endDate         DateTime?           @db.Date
  weekday         Int?
  weekdays        Int[]               @default([])
  dayOfMonth      Int?
  lastDayOfMonth  Boolean             @default(false)
  intervalDays    Int?
  skipHolidays    Boolean             @default(false)
  title           String
  status          SomaShiftStatus?
  period          RecurrencePeriod?
  startTime       String?
  durationMinutes Int?
  location        String?
  notes           String?
  reminderEnabled Boolean             @default(false)
  reminderMode    CalendarReminderMode @default(MINUTES_BEFORE)
  reminderMinutesBefore Int            @default(60)
  exceptions      CalendarRecurrenceException[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([startDate, endDate])
  @@index([kind, weekday])
}

model CalendarRecurrenceException {
  id              String             @id @default(cuid())
  recurrenceId    String
  recurrence      CalendarRecurrence @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)
  date            DateTime           @db.Date
  title           String
  status          SomaShiftStatus?
  period          RecurrencePeriod?
  startTime       String?
  durationMinutes Int?
  location        String?
  notes           String?
  reminderEnabled Boolean             @default(false)
  reminderMode    CalendarReminderMode @default(MINUTES_BEFORE)
  reminderMinutesBefore Int            @default(60)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([recurrenceId, date])
  @@index([date])
}

model CalendarReminderDelivery {
  id           String   @id @default(cuid())
  eventKey     String   @unique
  dueAt        DateTime
  sentAt       DateTime?
  claimedUntil DateTime?
  attempts     Int      @default(0)
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([dueAt, sentAt])
}

model Invoice {
  id                    String       @id @default(cuid())
  workId                String
  work                  Work         @relation(fields: [workId], references: [id], onDelete: Restrict)
  type                  InvoiceType
  serviceDate           DateTime     @db.Date
  invoiceDate           DateTime?    @db.Date
  invoiceNumber         String?      @db.VarChar(64)
  expectedPaymentDate   DateTime?    @db.Date
  pdfTotalAmount        Decimal?     @db.Decimal(18, 3)
  grossAmount           Decimal      @db.Decimal(18, 3)
  discountAmount        Decimal      @default(0) @db.Decimal(18, 3)
  shiftDiscountAmount   Decimal      @default(0) @db.Decimal(18, 3)
  netAmount             Decimal      @db.Decimal(18, 3)
  privateShiftCount     Int          @default(0)
  privateShiftAmount    Decimal      @default(0) @db.Decimal(18, 3)
  status                InvoiceStatus @default(PENDIENTE)
  paidAt                DateTime?    @db.Date
  notes                 String?
  items                 InvoiceItem[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([serviceDate, status])
  @@index([expectedPaymentDate])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitAmount  Decimal  @db.Decimal(18, 3)
  discountAmount Decimal @default(0) @db.Decimal(18, 3)
  grossAmount Decimal  @db.Decimal(18, 3)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model SocialSecurityPeriod {
  id             String   @id @default(cuid())
  month          DateTime @unique @db.Date
  grossAmount    Decimal  @default(0) @db.Decimal(18, 3)
  discounts      Decimal  @default(0) @db.Decimal(18, 3)
  netAmount      Decimal  @default(0) @db.Decimal(18, 3)
  ibcAmount      Decimal  @default(0) @db.Decimal(18, 3)
  minimumWageAmount        Decimal? @db.Decimal(18, 3)
  minimumWageSourceYear    Int?
  minimumWageSourceUrl     String?
  minimumWageStale         Boolean?
  pensionEnabled           Boolean?
  arlEnabled               Boolean?
  arlRiskClass             String?
  compensationFundEnabled  Boolean?
  ibcRatePpm               Int?
  healthRatePpm            Int?
  pensionRatePpm           Int?
  arlRatePpm               Int?
  fundRatePpm              Int?
  solidarityRatePpm        Int?
  healthAmount        Decimal @default(0) @db.Decimal(18, 3)
  pensionAmount       Decimal @default(0) @db.Decimal(18, 3)
  arlAmount           Decimal @default(0) @db.Decimal(18, 3)
  fundAmount          Decimal @default(0) @db.Decimal(18, 3)
  solidarityAmount    Decimal @default(0) @db.Decimal(18, 3)
  totalAmount         Decimal @default(0) @db.Decimal(18, 3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Debt {
  id                    String        @id @default(cuid())
  name                  String        @unique @default("Compra de acciones")
  shareCount            Int
  sharePriceAmount      Decimal       @db.Decimal(18, 3)
  originalAmount        Decimal       @db.Decimal(18, 3)
  contractualRatePpm    Int           @default(80000)
  lateFeeRatePpm        Int           @default(0)
  termMonths            Int
  startDate             DateTime      @db.Date
  schedule              DebtSchedule[]
  payments              DebtPayment[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model DebtSchedule {
  id               String                   @id @default(cuid())
  debtId           String
  debt             Debt                     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  installment      Int
  dueDate          DateTime                 @db.Date
  previousBalance  Decimal                  @db.Decimal(18, 3)
  monthlyInterest  Decimal                  @db.Decimal(18, 3)
  paymentAmount    Decimal                  @db.Decimal(18, 3)
  principalAmount  Decimal                  @db.Decimal(18, 3)
  interestAmount   Decimal                  @db.Decimal(18, 3)
  remainingBalance Decimal                  @db.Decimal(18, 3)
  allocations      DebtPaymentAllocation[]
  createdAt        DateTime                 @default(now())

  @@unique([debtId, installment])
  @@index([dueDate])
}

model DebtPayment {
  id             String                   @id @default(cuid())
  debtId         String
  debt           Debt                     @relation(fields: [debtId], references: [id], onDelete: Restrict)
  paidAt         DateTime                 @db.Date
  amount         Decimal                  @db.Decimal(18, 3)
  parkingAmount  Decimal                  @default(0) @db.Decimal(18, 3)
  notes          String?
  allocations    DebtPaymentAllocation[]
  createdAt      DateTime                 @default(now())

  @@index([paidAt])
}

model DebtPaymentAllocation {
  id                 String       @id @default(cuid())
  paymentId          String
  payment            DebtPayment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  scheduleId         String
  schedule           DebtSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  principalAmount    Decimal      @default(0) @db.Decimal(18, 3)
  interestAmount     Decimal      @default(0) @db.Decimal(18, 3)
  unclassifiedAmount Decimal      @default(0) @db.Decimal(18, 3)

  @@unique([paymentId, scheduleId])
}

model ParkingRate {
  id        String   @id @default(cuid())
  year      Int      @unique
  amount    Decimal  @default(0) @db.Decimal(18, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}